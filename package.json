{
  "name": "racehub-fe-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-typescript ../racehub-be-service/api/openapi.yaml -o lib/openapi.gen.ts",
    "check:api": "pnpm gen:api && git diff --exit-code -- lib/openapi.gen.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/saira": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "isomorphic-dompurify": "^3.18.0",
    "next": "16.2.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
