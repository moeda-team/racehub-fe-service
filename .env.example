# racehub-fe-service — environment template
# Copy to .env.local and adjust. Next.js auto-loads .env.local in dev.
# Only NEXT_PUBLIC_* vars are exposed to the browser.

# Server-only URL used by the same-origin Next.js BFF proxy. It must not use a
# NEXT_PUBLIC_ prefix: browsers call /api/v1 on this origin and never receive
# backend credentials or session tokens.
BACKEND_API_URL=http://localhost:3001
